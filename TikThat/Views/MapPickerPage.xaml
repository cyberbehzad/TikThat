<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:TikThat.ViewModels"
             x:Class="TikThat.Views.MapPickerPage"
             x:DataType="viewmodel:MapPickerViewModel"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft"
             BackgroundColor="#121218">

    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20, 45, 20, 12" BackgroundColor="#121218">
            <Button Grid.Column="0" 
                    Text="بازگشت" 
                    Command="{Binding CancelCommand}" 
                    BackgroundColor="Transparent" 
                    TextColor="#8E8E93" 
                    FontFamily="Vazirmatn"
                    FontSize="14"/>

            <Label Grid.Column="1" 
                   Text="انتخاب مکان یادآور" 
                   FontSize="17" 
                   FontAttributes="Bold" 
                   TextColor="White" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Center"
                   FontFamily="Vazirmatn"/>

            <ImageButton Grid.Column="2" 
                         Source="my_location_icon.png" 
                         Clicked="OnHeaderMyLocationClicked"
                         HeightRequest="36" 
                         WidthRequest="36" 
                         BackgroundColor="Transparent" 
                         VerticalOptions="Center"/>
        </Grid>

        <Grid Grid.Row="1">

            <WebView x:Name="MapWebView" 
                     Navigating="OnWebViewNavigating" 
                     HorizontalOptions="Fill" 
                     VerticalOptions="Fill"/>

            <Border x:Name="OfflineBorder"
                    IsVisible="False"
                    BackgroundColor="#1E1E26"
                    Stroke="#E53935"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 16"
                    Padding="20"
                    Margin="30"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <Label Text="⚠️ عدم دسترسی به اینترنت" 
                           TextColor="#E53935" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           FontFamily="Vazirmatn" 
                           HorizontalOptions="Center"/>

                    <Label Text="برای بارگذاری نقشه‌ها و جستجوی آدرس‌ها به اینترنت فعال نیاز است." 
                           TextColor="#CCCCCC" 
                           FontSize="13" 
                           FontFamily="Vazirmatn" 
                           HorizontalTextAlignment="Center"/>

                    <Button Text="تلاش مجدد 🔄" 
                            Clicked="OnRetryClicked" 
                            BackgroundColor="#8A4FFF" 
                            TextColor="White" 
                            CornerRadius="10" 
                            HeightRequest="40" 
                            FontFamily="Vazirmatn"/>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator x:Name="LoadingIndicator" 
                               IsVisible="False" 
                               IsRunning="False" 
                               Color="#00E5FF" 
                               HeightRequest="50" 
                               WidthRequest="50" 
                               VerticalOptions="Center" 
                               HorizontalOptions="Center"/>
        </Grid>

    </Grid>
</ContentPage>