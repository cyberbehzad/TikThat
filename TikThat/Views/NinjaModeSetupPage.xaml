<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:TikThat.ViewModels"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="TikThat.Views.NinjaModeSetupPage"
             x:DataType="viewmodel:NinjaModeSetupViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0C0C12">

    <Grid>
        <Image Source="ninja_setup_background.svg"
               Aspect="AspectFill"
               Opacity="0.25"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               InputTransparent="True"/>

        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

                <Label Text="آماده سازی ماموریت نینجا"
                       FontFamily="Vazirmatn"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#8A4FFF"/>

                <Border StrokeShape="RoundRectangle 16"
                        Stroke="#2A2A38"
                        StrokeThickness="1"
                        BackgroundColor="#161622"
                        Padding="20,15"
                        Margin="0,10,0,5">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="تسک هدف:"
                               FontFamily="Vazirmatn"
                               FontSize="12"
                               TextColor="#8A4FFF"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding TaskToFocus.Text}"
                               FontFamily="Vazirmatn"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="#FFFFFF"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="برای کسب مدال و امتیاز، باید پیش از پایان تایمر تسک را کامل کنید."
                       FontFamily="Vazirmatn"
                       FontSize="13"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="#FFA726"/>

                <Label Text="مدت زمان تمرکز (دقیقه)"
                       FontFamily="Vazirmatn"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="#B0B0C0"
                       Margin="0,10,0,0"/>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" MaximumWidthRequest="280" HorizontalOptions="Center">
                    <Button Grid.Column="0" Text="۱۵ د"
                            Command="{Binding SelectTimeCommand}" CommandParameter="15"
                            BackgroundColor="#1F1F2E" TextColor="White"
                            CornerRadius="12" HeightRequest="42" FontFamily="Vazirmatn"/>
                    <Button Grid.Column="1" Text="۲۵ د"
                            Command="{Binding SelectTimeCommand}" CommandParameter="25"
                            BackgroundColor="#2D1B4E" TextColor="#8A4FFF"
                            CornerRadius="12" HeightRequest="42" FontAttributes="Bold" FontFamily="Vazirmatn"/>
                    <Button Grid.Column="2" Text="۴۵ د"
                            Command="{Binding SelectTimeCommand}" CommandParameter="45"
                            BackgroundColor="#1F1F2E" TextColor="White"
                            CornerRadius="12" HeightRequest="42" FontFamily="Vazirmatn"/>
                </Grid>

                <Border StrokeShape="RoundRectangle 14"
                        BackgroundColor="#1A1A26"
                        Stroke="#35354A"
                        StrokeThickness="1"
                        Padding="15,0"
                        HorizontalOptions="Center"
                        WidthRequest="140"
                        HeightRequest="48">
                    <Entry Text="{Binding SelectedTime}"
                           Keyboard="Numeric"
                           FontFamily="Vazirmatn"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           BackgroundColor="Transparent"/>
                </Border>

                <Button Text="شروع ماموریت"
                        Command="{Binding StartNinjaSessionCommand}"
                        FontFamily="Vazirmatn"
                        FontAttributes="Bold"
                        FontSize="16"
                        TextColor="White"
                        Margin="0,25,0,0"
                        HeightRequest="54"
                        CornerRadius="27">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0078D4" Offset="0.0"/>
                            <GradientStop Color="#8A4FFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Shadow>
                        <Shadow Brush="#8A4FFF" Offset="0,4" Radius="15" Opacity="0.6"/>
                    </Button.Shadow>
                </Button>

                <Button Text="انصراف و بازگشت"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#7E7E92"
                        FontFamily="Vazirmatn"
                        FontSize="13"
                        HeightRequest="40"/>
            </VerticalStackLayout>
        </ScrollView>

        <skia:SKLottieView
            Source="ink_transition.json"
            RepeatCount="0"
            IsAnimationEnabled="{Binding IsTransitioning}"
            IsVisible="{Binding IsTransitioning}"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True"
            ZIndex="999"/>
    </Grid>
</ContentPage>