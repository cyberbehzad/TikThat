<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>TikThat</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationTitle>TikThat</ApplicationTitle>
		<ApplicationId>com.companyname.tikthat</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Minimum supported OS versions -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<GenerateDocumentationFile>false</GenerateDocumentationFile>

		<!-- Enable compiled XAML bindings across all platforms -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
	</PropertyGroup>

	<!-- ==================== Android ==================== -->
	<!-- General Android settings -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
		<AndroidEnableSGenConcurrent>true</AndroidEnableSGenConcurrent>
	</PropertyGroup>

	<!-- Android Debug -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Debug'">
		<RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<!-- Minimum supported OS versions -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Release'">

		<!-- Enable compiled XAML bindings across all platforms -->
		<RuntimeIdentifier Condition="'$(Universal)' != 'true' and '$(AndroidArch)' != 'arm'">android-arm64</RuntimeIdentifier>

		<!-- ==================== Android ==================== -->
		<RuntimeIdentifier Condition="'$(Universal)' != 'true' and '$(AndroidArch)' == 'arm'">android-arm</RuntimeIdentifier>

		<!-- General Android settings -->
		<RuntimeIdentifiers Condition="'$(Universal)' == 'true'">android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>

		<!-- Android Debug -->
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>full</TrimMode>
		<TrimmerSingleWarn>false</TrimmerSingleWarn>

		<!-- Android Release (size-optimized) -->
		<AndroidLinkTool>r8</AndroidLinkTool>

		<!-- Default to arm64 -->
		<AndroidEnableAssemblyCompression>true</AndroidEnableAssemblyCompression>

		<!-- Pass -p:AndroidArch=arm for legacy 32-bit devices -->
		<RunAOTCompilation>false</RunAOTCompilation>
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
		<EnableLLVM>false</EnableLLVM>

		<!-- Pass -p:Universal=true to include all ABIs -->
		<UseSystemResourceKeys>true</UseSystemResourceKeys>
		<DebuggerSupport>false</DebuggerSupport>
		<EventSourceSupport>false</EventSourceSupport>
		<MetadataUpdaterSupport>false</MetadataUpdaterSupport>

		<!-- Full IL trimming -->
		<AndroidPackageFormat>apk</AndroidPackageFormat>

		<!-- Shrink Java bytecode with R8 -->
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
		<AndroidIncludeDebugSymbols>false</AndroidIncludeDebugSymbols>
	</PropertyGroup>

	<!-- Compress bundled assemblies -->
	<!-- Disable AOT to minimize package size -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-windows')) and '$(Configuration)' == 'Release'">
		<!-- Strip non-essential runtime features -->
		<WinArch Condition="'$(WinArch)' == ''">x64</WinArch>
		<RuntimeIdentifier>win-$(WinArch)</RuntimeIdentifier>
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<SelfContained>true</SelfContained>
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
	</PropertyGroup>

	<!-- Output APK (switch to aab for Google Play) -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-maccatalyst')) and '$(Configuration)' == 'Release'">
		<!-- Strip debug symbols -->
		<RuntimeIdentifier Condition="'$(MacArch)' == 'arm64'">maccatalyst-arm64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(MacArch)' == 'x64'">maccatalyst-x64</RuntimeIdentifier>
		<RuntimeIdentifiers Condition="'$(MacArch)' == ''">maccatalyst-arm64;maccatalyst-x64</RuntimeIdentifiers>

		<MtouchLink>SdkOnly</MtouchLink>
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
	</PropertyGroup>

	<!-- ==================== iOS ==================== -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-ios')) and '$(Configuration)' == 'Release'">
		<!-- ==================== Windows ==================== -->
		<RuntimeIdentifier Condition="'$(Simulator)' != 'true'">ios-arm64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(Simulator)' == 'true'">iossimulator-arm64</RuntimeIdentifier>

		<MtouchLink>SdkOnly</MtouchLink>
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
	</PropertyGroup>

	<!-- Windows Release: unpackaged & self-contained -->
	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" />
		<MauiSplashScreen Include="Resources\Splash\tikthat_splash.svg" Color="#121218" BaseSize="180,180" />

		<!-- Defaults to x64; override via -p:WinArch=x86 or arm64 -->
		<MauiImage Include="Resources\Images\*" Exclude="Resources\Images\*.svg" />

		<!-- ==================== Mac Catalyst ==================== -->
		<MauiImage Include="Resources\Images\*.svg" BaseSize="128,128" />

		<!-- Single-arch via -p:MacArch=arm64|x64, defaults to universal -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- ==================== iOS ==================== -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- Target physical devices by default; pass -p:Simulator=true for simulator -->
		<MauiAsset Remove="**\*.apk" />
		<MauiAsset Remove="**\*.aab" />
		<AndroidAsset Remove="**\*.apk" />
		<AndroidAsset Remove="**\*.aab" />
	</ItemGroup>

	<!-- ==================== Icons & Images ==================== -->
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />

		<!-- Raster images (PNG, JPG) without BaseSize -->
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.120" Condition="$(TargetFramework.Contains('-windows'))" />

		<!-- Vector SVGs with explicit BaseSize for Resizetizer -->
		<PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" Condition="$(TargetFramework.Contains('-windows'))" />

		<!-- Fonts -->
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.14" Condition="'$(Configuration)' == 'Debug'" />

		<PackageReference Include="Plugin.Fingerprint" Version="3.0.0-beta.1" />
		<PackageReference Include="Plugin.LocalNotification" Version="14.1.2" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.154.0" />
		<PackageReference Include="SkiaSharp.Extended.UI.Maui" Version="3.0.0" />
		<PackageReference Include="Shiny.Core" Version="6.5.2" />
		<PackageReference Include="Shiny.Hosting.Maui" Version="6.5.2" />
		<PackageReference Include="Shiny.Locations" Version="6.5.2" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
	</ItemGroup>

</Project>